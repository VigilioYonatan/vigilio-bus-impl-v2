NODE_ENV=development
APP_STAGE=local
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:4200
DATABASE_URL=postgres://bus:local-only-not-for-cloud@127.0.0.1:55432/bus
E2E_DATABASE_ADMIN_URL=postgres://bus:local-only-not-for-cloud@127.0.0.1:55432/postgres
E2E_DATABASE_URL=postgres://bus:local-only-not-for-cloud@127.0.0.1:55432/bus_impl_e2e
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
UPLOAD_BUCKET_NAME=bus-impl-local-uploads
SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/bus-impl-v2-events
WORKER_WAIT_TIME_SECONDS=20
WORKER_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_MAX_MESSAGES=10
UPLOAD_KEY_PREFIX=uploads
UPLOAD_PRESIGNED_URL_EXPIRY_SECONDS=900
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=0.9
JWT_SECRET=change-me-min-32-chars-for-local-only
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
AUTH_REFRESH_COOKIE_NAME=rimac_refresh
AUTH_REFRESH_COOKIE_PATH=/auth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
